#!/usr/bin/env bash

set -euo pipefail

. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/lib.sh"

usage() {
    cat <<EOF
Usage: $(basename "$0") [system] [--skip-gc] [darwin-rebuild args...]

Build and switch a nix-darwin system from this flake.

Examples:
  $(basename "$0")
  $(basename "$0") C2JF2NTH6H
  $(basename "$0") olisikh-mini --show-trace
  $(basename "$0") --skip-gc
EOF
}

default_system() {
    if command -v scutil >/dev/null 2>&1; then
        local local_hostname
        local_hostname="$(scutil --get LocalHostName 2>/dev/null || true)"

        if [[ -n "$local_hostname" ]]; then
            echo "$local_hostname"
            return
        fi
    fi

    hostname -s
}

main() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        usage
        exit 0
    fi

    check_command darwin-rebuild

    local system=""
    local skip_gc=false
    if [[ $# -gt 0 && "$1" != -* ]]; then
        system="$1"
        shift
    else
        system="$(default_system)"
    fi

    local -a rebuild_args=()
    for arg in "$@"; do
        if [[ "$arg" == "--skip-gc" ]]; then
            skip_gc=true
        else
            rebuild_args+=("$arg")
        fi
    done

    sudo "$NIX_DOTFILES_SCRIPT_DIR/nix-build-privileged" \
        "$NIX_DOTFILES_ROOT" "$system" "$NIX_DOTFILES_SCRIPT_DIR" "$skip_gc" "${rebuild_args[@]}"
}

main "$@"
