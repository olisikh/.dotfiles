#!/usr/bin/env bash

set -euo pipefail

. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/lib.sh"

usage() {
    cat <<EOF
Usage: $(basename "$0") <command> [args...]

Commands:
  build, make           Build and switch this nix-darwin system (pass --skip-gc to skip generation pruning)
  update                Update flake inputs and pinned source hashes
  upgrade               Update, then build and switch
  tpl                   Instantiate a template from this flake
  dev                   Run a dev shell from this flake
  gens                  List nix-darwin generations
  rb                    Roll back to a previous generation
  gc                    Run Nix garbage collection
  secrets               Edit the home sops secrets file
  sync                  Sync my repos (dotfiles, harness, notes)
  help                  Show this help
EOF
}

notes_repository() {
    printf '%s\n' @notesRepository@
}

ensure_repo() {
    local repo_path="$1"
    local remote_url="$2"
    local configured_remote

    if [[ -e "$repo_path" || -L "$repo_path" ]]; then
        if ! configured_remote="$(git -C "$repo_path" remote get-url origin 2>/dev/null)"; then
            echo "Error: $repo_path has no origin remote" >&2
            return 1
        fi
        if [[ "$configured_remote" != "$remote_url" ]]; then
            echo "Error: $repo_path origin is $configured_remote; expected $remote_url" >&2
            return 1
        fi
        return 0
    fi

    echo "==> cloning $(basename "$repo_path")"
    mkdir -p "$(dirname "$repo_path")"
    git clone --recurse-submodules "$remote_url" "$repo_path"
}

sync_repo() {
    local repo_path="$1"
    local repo_root
    local name

    if ! repo_root="$(git -C "$repo_path" rev-parse --show-toplevel 2>/dev/null)"; then
        echo "Error: $repo_path is not inside a git repository" >&2
        return 1
    fi
    repo_root="$(cd "$repo_root" && pwd -P)"
    name="$(basename "$repo_root")"

    echo "==> $name"

    if ! git -C "$repo_root" pull --rebase --autostash origin main; then
        echo "Error: failed to sync $name" >&2
        return 1
    fi
}

sync_harness() {
    local repo_path="$1"
    local repo_root

    if ! repo_root="$(git -C "$repo_path" rev-parse --show-toplevel 2>/dev/null)"; then
        echo "Error: $repo_path is not inside a git repository" >&2
        return 1
    fi
    repo_root="$(cd "$repo_root" && pwd -P)"

    echo "==> $(basename "$repo_root") skills"
    if ! (cd "$repo_root" && ./harness.py update-repo); then
        echo "Error: failed to update harness skills" >&2
        return 1
    fi
}

cmd_sync() {
    local harness_repo="$HOME/.llm-harness"
    local notes_repo="$HOME/notes"
    local notes_remote
    notes_remote="$(notes_repository)"

    if ! sync_repo "$HOME/.dotfiles" \
        || ! sync_harness "$harness_repo" \
        || ! ensure_repo "$notes_repo" "$notes_remote" \
        || ! sync_repo "$notes_repo"; then
        echo "Sync cancelled." >&2
        exit 1
    fi

    echo "All repositories and harness skills synced."
}

main() {
    local command="${1:-help}"
    if [[ $# -gt 0 ]]; then
        shift
    fi

    case "$command" in
    build | make)
        nix-build "$@"
        ;;
    update)
        nix-update "$NIX_DOTFILES_ROOT" "$@"
        ;;
    upgrade)
        nix-update "$NIX_DOTFILES_ROOT" "$@"
        nix-build
        ;;
    tpl)
        nix-tpl "$@"
        ;;
    dev)
        nix-dev "$@"
        ;;
    gens)
        nix-gens "$@"
        ;;
    rb)
        nix-rollback "$@"
        ;;
    gc)
        nix-gc "$@"
        ;;
    secrets)
        nix-secrets "$@"
        ;;
    sync)
        cmd_sync
        ;;
    help | -h | --help)
        usage
        ;;
    *)
        echo "Error: unknown command: $command" >&2
        usage >&2
        exit 1
        ;;
    esac
}

main "$@"
